# Purelymail SMTP credentials for the contact form (src/app/api/contact/route.ts)
# Copy this file to .env.local and fill in real values. Never commit .env.local.
PURELYMAIL_SMTP_USER=info@ragtime.pro
PURELYMAIL_SMTP_PASS=
MAIL_FROM_ADDRESS=
MAIL_INFO_ADDRESS=
# Comma-separated addresses to never acknowledge (own sending addresses, to prevent reply loops)
MAIL_ACK_BLOCKLIST=

# Purelymail IMAP credentials for polling the info@ inbox (src/app/api/inbox-poll/route.ts)
PURELYMAIL_IMAP_HOST=
PURELYMAIL_IMAP_PORT=
PURELYMAIL_IMAP_USER=
PURELYMAIL_IMAP_PASS=

# Purelymail IMAP credentials for polling the noreply@ inbox, same host/port
# as above, different mailbox login. Messages sent here always get a
# "wrong address, please use the site instead" redirect, never a real
# answer (src/lib/acknowledgement.ts's sendNoreplyRedirect()).
PURELYMAIL_IMAP_USER_NOREPLY=
PURELYMAIL_IMAP_PASS_NOREPLY=

# Shared secret the external cron trigger must send as "Authorization: Bearer <this>"
INBOX_POLL_SECRET=

# Azure OpenAI (shared resource/credentials for every Azure OpenAI call on
# the site: contact form's AI-generated acknowledgement reply, the main
# site's RAG chat, and the ALMENDRO demo's RAG chat). Each caller specifies
# its own deployment at client construction time (src/rag/azureClient.ts:
# o4-mini; src/almendro/azureClient.ts: gpt-4o-mini) - this is the one
# resource endpoint/key behind all of them.
# Resource endpoint (classic *.openai.azure.com), not the Foundry project endpoint.
AZURE_OPENAI_ENDPOINT=
AZURE_AI_PROJECT_API_KEY=

# Cloudflare R2 (chat session storage + email correspondence history)
R2_S3_CLIENTS_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
